{
  "advisor": {
    "model": "openrouter/anthropic/claude-opus-5.5",
    "maxTokens": 8192,
    "cache": "short"
  },
  "pack": {
    "budgetTokens": 40000,
    "excludePaths": [
      ".pi/baton/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/package-lock.json",
      "**/npm-shrinkwrap.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lock",
      "**/bun.lockb",
      "**/Cargo.lock",
      "**/poetry.lock",
      "**/uv.lock",
      "**/go.sum",
      "**/composer.lock",
      "**/Gemfile.lock"
    ],
    "skills": {
      "enabled": true,
      "budgetRatio": 0.35,
      "maxSkills": 4,
      "dirs": [
        ".agents/skills",
        ".pi/skills",
        ".claude/skills",
        "skills"
      ]
    },
    "pinPlan": true,
    "helpLastCalls": 8
  },
  "review": {
    "enabled": true,
    "minDiffLines": 80,
    "minCalls": 15,
    "helpMinCalls": 5,
    "finalizeAfterDone": true
  },
  "triggers": {
    "contextRatio": 0.6,
    "sameErrorCount": 3,
    "reviewBeforeCommit": true,
    "remindEvery": 12,
    "minGapCalls": 5,
    "milestoneReview": true,
    "autoPlanAfterReads": 8,
    "planBeforeWrite": true,
    "driftCalls": 20
  },
  "loop": {
    "enabled": true,
    "windowCalls": 30,
    "maxHops": 6,
    "hopGapCalls": 30,
    "readRepeatThreshold": 8,
    "action": "help",
    "blockDeferredEdits": true,
    "ignoreReadPaths": [
      "**/node_modules/**",
      "**/SKILL.md",
      "**/REFERENCE.md",
      "**/README.md",
      "**/AGENTS.md",
      ".agents/**",
      ".pi/**",
      "docs/**"
    ]
  },
  "compact": {
    "enabled": false,
    "keepTurns": 2,
    "keepCalls": 2,
    "exemptTools": [
      "baton_review",
      "baton_help",
      "baton_plan",
      "baton_step"
    ],
    "neverMaskPaths": [
      "**/SKILL.md",
      ".agents/skills/**",
      ".pi/skills/**",
      ".claude/skills/**",
      "skills/**/*.md",
      "**/AGENTS.md",
      "**/CLAUDE.md",
      "**/README.md",
      "**/REFERENCE.md",
      "docs/**/*.md"
    ],
    "replaceAutoCompact": true
  },
  "journalDir": ".pi/baton"
}
