{
  "name": "pi-baton",
  "version": "0.13.1",
  "description": "Baton: an efficient review agent for pi — prepares a tool-less, cache-friendly review pack (diff, files, tests, project skills, pinned plan, unverified claims) for an expensive advisor model",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "review",
    "code-review",
    "advisor",
    "context"
  ],
  "license": "MIT",
  "author": "artalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artalar/baton.git"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "skills",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "baton.example.json"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "coverage": "vitest run --coverage",
    "smoke": "bash scripts/smoke-pack.sh",
    "prepublishOnly": "bun run check && bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-ai": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "baton-pack": "./bin/baton-pack.mjs",
    "baton-review": "./bin/baton-review.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    }
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
