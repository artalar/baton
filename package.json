{
  "name": "pi-baton",
  "version": "0.12.2",
  "description": "Baton: an efficient review agent for pi \u2014 prepares a tool-less, cache-friendly review pack (diff, files, tests, project skills, pinned plan, unverified claims) for an expensive advisor model",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "review",
    "code-review",
    "advisor",
    "context"
  ],
  "license": "MIT",
  "author": "artalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artalar/baton.git"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "baton.example.json"
  ],
  "pi": {
    "extensions": [
      "./src/pi/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-ai": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "baton-pack": "./bin/baton-pack.mjs",
    "baton-review": "./bin/baton-review.mjs"
  },
  "exports": {
    ".": "./src/core/index.ts",
    "./core": "./src/core/index.ts",
    "./pi": "./src/pi/index.ts"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  }
}
