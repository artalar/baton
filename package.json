{
  "name": "pi-baton",
  "version": "0.4.0",
  "description": "Baton: journal, handoff-only compaction, advisor (review/help/plan) and safety triggers for the pi coding agent",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction",
    "context",
    "advisor"
  ],
  "license": "MIT",
  "author": "artalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artalar/baton.git"
  },
  "files": [
    "src",
    "skills",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "baton.example.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-ai": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
