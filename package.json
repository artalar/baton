{
  "name": "pi-baton",
  "version": "0.13.1",
  "description": "Baton: speculative execution for pi — after the lead model's tool calls, a cheaper model continues in the same session; the lead then sees one alert of that work",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "speculative-execution",
    "agent",
    "cost"
  ],
  "license": "MIT",
  "author": "artalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artalar/baton.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "analyze": "bun scripts/analyze-session.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "coverage": "vitest run --dir test --coverage",
    "smoke": "bash scripts/smoke-pack.sh",
    "prepublishOnly": "bun run check && bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
